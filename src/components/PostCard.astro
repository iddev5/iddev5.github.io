---
const { title, date, url, tags } = Astro.props;
import IconArrowRight from "../assets/icons/arrow-right.svg";
---

<a href={url} class="flex h-full flex-col gap-2">
  <div
    class="mx-4 mt-2 flex items-center justify-between gap-6 decoration-dashed hover:underline"
  >
    <div class="flex items-center gap-3">
      <h3 class="text-foreground text-xl opacity-90">
        {title}
      </h3>
    </div>
    <div class="flex">
      <p class="mt-1 text-sm opacity-80">
        {date}
      </p>
    </div>
  </div>
